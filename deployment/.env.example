# Copy to deployment/.env and fill in values.

# ── ChromaDB ────────────────────────────────────────────────────────────────
CHROMA_AUTH_TOKEN=replace-with-a-long-random-token
CHROMA_COLLECTION_NAME=research_chunks_v1

# ── Embedding (FastEmbed) ─────────────────────────────────────────────────
EMBEDDING_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RETRIEVAL_TOP_K=4
MAX_CONTEXT_CHARS=12000

# ── Local GGUF (default) ─────────────────────────────────────────────────
LLM_MODEL=Qwen3.5-4B.Clean-Recovery.Q4_K_M.gguf
LLAMA_MMPROJ_FILENAME=Qwen3.5-4B.BF16-mmproj.gguf
LLM_MODEL_NAME=qwen3.5-private-analyst

# ── Ollama (optional: bootstrap_local.py --inference ollama) ──────────────
# Must already exist in the persistent Ollama volume; bootstrap verifies availability only.
OLLAMA_MODEL=private-analyst-qwen35

# LLM generation params
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=900
LLM_TIMEOUT_SECONDS=120

# ── Optional nginx proxy ──────────────────────────────────────────────────
# Relies on TLS certificates in deployment/certs/
